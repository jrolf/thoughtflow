# ThoughtFlow API Keys - Example Template
# Copy this file to .env and fill in your actual keys.
# The .env file is gitignored and will not be committed.

# Enable integration tests (set to 1 to run tests that call real APIs)
THOUGHTFLOW_INTEGRATION_TESTS=0

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Groq
GROQ_API_KEY=gsk_your-groq-key-here

# Cerebras
CEREBRAS_API_KEY=your-cerebras-key-here
# CEREBRAS_API_KEY_FALLBACK=optional-rotation-key

# Google Gemini (LLM and EMBED integration tests use GOOGLE_API_KEY)
GOOGLE_API_KEY=your-gemini-key-here
# GEMINI_API_KEY=alternate-name-ok-but-tests-read-GOOGLE_API_KEY

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Ollama (typically no key needed for local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3:latest

# Search providers (optional, for SEARCH action integration tests)
# BRAVE_API_KEY=
# EXA_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
